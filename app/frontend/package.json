{
	"name": "holyarrs-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/vendor-hls.mjs && vite build && node scripts/precompress.mjs && node scripts/check-words.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
