{
	"name": "holyarrs-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "node scripts/pack-lang.mjs && vite dev",
		"build": "node scripts/vendor-hls.mjs && node scripts/pack-lang.mjs && vite build && node scripts/check-words.mjs",
		"postbuild": "node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\"",
		"lint": "eslint src",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-check --tsconfig ../tests/tsconfig.check.json --fail-on-warnings",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource/silkscreen": "^5.3.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.14.0",
		"eslint-plugin-import-x": "^4.18.0",
		"simple-icons": "^14.15.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/anton": "^5.3.0",
		"hls.js": "1.7.3"
	},
	"overrides": {
		"minimatch": "^11.0.1"
	}
}
