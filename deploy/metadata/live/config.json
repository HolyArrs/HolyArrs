{
  "listen": ":8080",
  "data_dir": "/data",
  "providers": {
    "tmdb": {
      "key_env": "HOLYARRS_TMDB_READ_TOKEN",
      "interval_ms": 50,
      "concurrency": 6
    },
    "musicbrainz": {
      "interval_ms": 1100
    },
    "tvmaze": {
      "interval_ms": 1000
    }
  },
  "cache_bytes": 1073741824,
  "cache_entries": 500000,
  "min_free_bytes": 16106127360,
  "ttl_seconds": 604800,
  "stale_seconds": 604800,
  "operation_ttl_seconds": {
    "tmdb:tmdb": 21600
  },
  "per_minute": 120,
  "burst": 200,
  "per_token_concurrent": 8,
  "max_concurrent": 100,
  "max_pending": 200,
  "client_per_minute": 240,
  "client_burst": 60,
  "client_auth_per_minute": 480,
  "client_auth_burst": 300,
  "trusted_proxies": [
    "172.18.0.0/16"
  ],
  "open_registration": true,
  "register_per_hour": 3,
  "register_global_per_hour": 600,
  "registered_idle_days": 90,
  "registered_max": 100000,
  "service_top": {
    "key_env": "HOLYARRS_MOTN_KEY",
    "backup_key_env": "HOLYARRS_MOTN_KEY_BACKUP",
    "active_env": "HOLYARRS_MOTN_ACTIVE",
    "regions": [
      "US"
    ]
  },
  "music_trending": true,
  "trailers": true,
  "stats_token_env": "HOLYARRS_STATS_TOKEN",
  "user_agent": "HolyArrsMetadata/0.2 (+https://github.com/CoderLuii/HolyArrs)",
  "anime": true,
  "wikidata": true,
  "refresh": true,
  "speed": {}
}